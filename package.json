{
  "name": "@clanker-code/pi-monitor",
  "version": "0.2.0",
  "description": "Pi extension that watches background processes and delivers regex-matching stdout windows to the agent session.",
  "type": "module",
  "license": "Unlicense",
  "author": "XertroV",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "background-jobs",
    "monitoring",
    "notifications"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clankercode/pi-monitor.git"
  },
  "homepage": "https://github.com/clankercode/pi-monitor#readme",
  "bugs": {
    "url": "https://github.com/clankercode/pi-monitor/issues"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/**/*.test.ts",
    "check": "tsc --noEmit && node --import tsx --test tests/*.test.ts tests/**/*.test.ts",
    "prepublishOnly": "pnpm run check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "0.79.4",
    "@earendil-works/pi-tui": "0.79.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0"
  }
}
